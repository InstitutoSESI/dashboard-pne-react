{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pne.local/contracts/vocacoes-pne-ui-v2-macroblock.schema.json",
  "title": "Macrobloco UI V2 — Vocações × PNE",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "macroblockId",
    "directionId",
    "sequence",
    "title",
    "summary",
    "primaryQuestion",
    "familyIds",
    "visualContractId"
  ],
  "properties": {
    "macroblockId": {
      "type": "string",
      "enum": [
        "A_DEMOGRAPHY_AND_OFFER",
        "B_TRAJECTORY_AND_CONDITIONS",
        "C_MOBILITY_AND_HIGH_SCHOOL",
        "D_RURALITY_AND_TRANSPORT",
        "E_INCLUSION_AND_ADULTS",
        "F_YOUTH_WORK_AND_TRAINING",
        "G_ECONOMY_EPT_AND_COORDINATION"
      ]
    },
    "directionId": {
      "type": "string",
      "enum": [
        "TERRITORY_HELPS_UNDERSTAND_EDUCATION",
        "TERRITORIAL_TRANSFORMATIONS_SET_EDUCATION_AGENDA"
      ]
    },
    "sequence": { "type": "integer", "minimum": 1, "maximum": 7 },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "primaryQuestion": { "type": "string", "minLength": 1 },
    "familyIds": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "uniqueItems": true
    },
    "visualContractId": { "type": "string", "minLength": 1 }
  }
}
