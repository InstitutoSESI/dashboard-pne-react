  "regrasPar": [
    {
      "ordem": 1,
      "reasonCode": "mecanismo-desconhecido",
      "descricao": "mechanismId não está no catálogo."
    },
    {
      "ordem": 2,
      "reasonCode": "faixa-etaria-incompativel",
      "descricao": "Par educacional×populacional avaliado pela relação entre a faixa da série populacional e a população de referência da série educacional: faixa territorial contida na referência ou idêntica a ela é compatível; faixa territorial mais ampla que a referência é aproximação e só passa via paresProvisorios do mecanismo, com aviso aproximacao-declarada, nunca silenciosamente; sobreposição parcial ou disjunção é bloqueada. Caso canônico: populacao-de-0-a-14-anos × matriculas-no-ensino-medio (0–14 ∩ 15–17 = ∅) — P3."
    },
    {
      "ordem": 3,
      "reasonCode": "cadastro-nao-denominador",
      "descricao": "Série cadastro_social em par de leitura com série educacional (cadastro é só contexto de vulnerabilidade; nunca par, nunca denominador)."
    },
    {
      "ordem": 4,
      "reasonCode": "sem-recorte-de-idade",
      "descricao": "Série de trabalho sem faixa etária (vinculos-formais-ativos etc.) usada para fenômeno juvenil (mecanismo com populacaoReferencia dentro de 15–24), exceto permissão explícita do mecanismo com nota (caso M6-tempo-integral, fenômeno familiar)."
    },
    {
      "ordem": 5,
      "reasonCode": "fotografia-nao-serie",
      "descricao": "Série coorte_censitaria usada por mecanismo cuja defasagem não é do tipo acumulada."
    },
    {
      "ordem": 6,
      "reasonCode": "fora-do-catalogo",
      "descricao": "Par não listado em paresPermitidos/paresProvisorios do mecanismo (default-deny; inclui séries que nem existem no registro)."
    },
    {
      "ordem": 7,
      "reasonCode": "serie-desconhecida",
      "descricao": "Par listado mas alguma série não resolve no registro (erro de catálogo; o teste de referências cruzadas impede na prática)."
    },
    {
      "ordem": 8,
      "reasonCode": "janela-insuficiente",
      "descricao": "Sobreposição de períodos anuais dos dois lados menor que janelaMinimaPontos do mecanismo (fora de tipo acumulada; séries pendente_* sem período ficam isentas — a janela é conferida quando os dados chegarem, na R3)."
    },
    {
      "ordem": 9,
      "reasonCode": "lente-mista-nao-declarada",
      "descricao": "Razão matrícula (lente escolas_da_regiao) ÷ população (lente residentes) sem o marcador atendimento_aparente na chamada. Com o marcador, o par é aceito e o rótulo interno registra que valores acima de 100 são possíveis (deslocamento e idades fora da faixa); a redação pública segue o contrato §7.2."
    },
    {
      "ordem": 10,
      "reasonCode": null,
      "descricao": "Períodos preliminares (preliminaryPeriods do registro) nunca contam para a janela nem para valores citados (herdado; aplicado no motor da R5, registrado aqui como regra)."
    }
  ]
}
