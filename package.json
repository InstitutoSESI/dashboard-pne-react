{
  "name": "dashboard-pne-react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:app": "vite build --mode app-only --outDir dist/app-only",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check:fast": "npm run typecheck && npm run lint && npm run build:app",
    "preview": "vite preview",
    "check:state-json": "node scripts/checks/verify-state-reference.cjs",
    "check:state-json:closed": "node scripts/checks/verify-state-reference.cjs public/data/pne_2014_2024/referencia_estadual.json",
    "list:indicators": "node scripts/checks/list-indicators.cjs",
    "test:app-routing": "node scripts/checks/app-routing-test.mjs",
    "test:municipality-identity": "node --test --test-concurrency=1 scripts/checks/municipality-identity.test.mjs",
    "test:data-sources": "node scripts/checks/verify-data-source-notes.cjs",
    "test:pne-cycle": "node --test scripts/checks/pne-accumulative-cycle.test.mjs",
    "test:pne-methodology": "node --test scripts/checks/pne-methodology-safety.test.mjs",
    "test:diagnostic": "node --test --test-concurrency=1 scripts/checks/pne2026-diagnostic-v3.test.mjs scripts/checks/pne2026-diagnostic-loader.test.mjs",
    "test:municipal-finance": "node --test --test-concurrency=1 scripts/checks/financial-final-dgf5f.test.mjs scripts/checks/municipal-finance-p5b1.test.mjs scripts/checks/qse-annual.test.mjs",
    "test:education": "node scripts/checks/education-test.mjs",
    "test:ui-architecture": "node scripts/checks/ui-architecture-test.mjs",
    "check:hygiene": "node scripts/checks/repository-hygiene-test.mjs",
    "test:unit": "node --test --test-concurrency=1 scripts/checks/financial-final-dgf5f.test.mjs scripts/checks/municipal-finance-p5b1.test.mjs scripts/checks/pne-accumulative-cycle.test.mjs scripts/checks/pne-chart-system.test.mjs scripts/checks/pne2026-contract-parity.test.mjs scripts/checks/pne2026-diagnostic-v3.test.mjs scripts/checks/pne2026-diagnostic-loader.test.mjs scripts/checks/qse-annual.test.mjs",
    "python:sync": "uv sync --project data_pipeline --group test --frozen",
    "python:lock:check": "uv lock --project data_pipeline --check",
    "check:python-deps": "uv run --project data_pipeline --group test --frozen python -m pytest data_pipeline/tests/test_dependency_contract.py",
    "test:pipeline-state-config": "uv run --project data_pipeline --group test --frozen python -m pytest data_pipeline/tests/test_state_config.py data_pipeline/tests/test_municipality_registry.py data_pipeline/tests/test_partition_static_data.py data_pipeline/tests/test_update_static_data.py data_pipeline/tests/test_validate_static_details.py data_pipeline/tests/test_materialize_municipal_inequality.py data_pipeline/tests/test_pne_macro_round.py",
    "test:pipeline-education-state": "uv run --project data_pipeline --group test --frozen python -m pytest data_pipeline/tests/test_pipeline_education_state.py data_pipeline/tests/test_export_education_indicators_matriculas.py data_pipeline/tests/test_municipal_education_overview.py data_pipeline/tests/test_materialize_municipal_education_overview.py data_pipeline/tests/test_higher_education.py data_pipeline/tests/test_special_education_materialization.py",
    "test:python": "uv run --project data_pipeline --group test --frozen python -m pytest data_pipeline/tests",
    "test:e2e": "node scripts/checks/current-platform-e2e-test.cjs",
    "generate:diagnostic-catalog": "node scripts/generate-diagnostic-catalog.mjs",
    "generate:pne-contract-artifacts": "node scripts/generate-diagnostic-catalog.mjs",
    "check:pne-contract": "node scripts/generate-diagnostic-catalog.mjs --check && node --test scripts/checks/pne2026-contract-parity.test.mjs",
    "update:education-data": "uv run --project data_pipeline --frozen python data_pipeline/scripts/update_static_data.py --education-only",
    "update:indigenous-coverage": "uv run --project data_pipeline --frozen python data_pipeline/scripts/sync_indigenous_population_from_sidra.py --apply && uv run --project data_pipeline --frozen python data_pipeline/scripts/export_education_indicators.py",
    "update:data": "uv run --project data_pipeline --frozen python data_pipeline/scripts/update_static_data.py",
    "update:data:skip-build": "uv run --project data_pipeline --frozen python data_pipeline/scripts/update_static_data.py --skip-build",
    "verify:indicator": "uv run --project data_pipeline --frozen python data_pipeline/scripts/export_static_data.py",
    "validate:details": "uv run --project data_pipeline --frozen python data_pipeline/scripts/validate_static_details.py"
  },
  "dependencies": {
    "@fontsource/public-sans": "^5.2.7",
    "@fontsource/source-serif-4": "^5.2.9",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "playwright": "^1.60.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.64.0",
    "vite": "^8.0.12"
  }
}
